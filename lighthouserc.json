{
  "ci": {
    "collect": {
      "url": [
        "http://localhost:8123/",
        "http://localhost:8123/pages/quienes-somos.html",
        "http://localhost:8123/pages/servicios.html",
        "http://localhost:8123/pages/contacto.html",
        "http://localhost:8123/pages/terminos.html",
        "http://localhost:8123/pages/blog-energia-solar.html"
      ],
      "numberOfRuns": 1,
      "settings": {
        "preset": "desktop"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "warn",
          {
            "minScore": 0.7
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 0.85
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 0.9
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "document-title": "off",
        "html-has-lang": "off"
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
